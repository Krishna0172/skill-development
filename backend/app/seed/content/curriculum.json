  "projects": [
    {
      "slug": "proj-text-to-sql",
      "title": "Local text-to-SQL assistant with evaluation",
      "track": "ai",
      "level": "advanced",
      "why_md": "Builds directly on GetLlmData (the text-to-SQL chat backend you worked on) and on your strongest skill: SQL over real e-commerce data. Adds what was missing there: prompting, schema context, structured output, SQL validation, and an evaluation set.",
      "steps": [
        "Sample e-commerce schema in PostgreSQL (orders, settlements, returns)",
        "FastAPI endpoint: question -> schema-aware prompt -> SQL",
        "Run a local model via Ollama (no external API) or a pluggable provider",
        "Validate SQL (read-only role, EXPLAIN before execute, row limits)",
        "Evaluation set of 30 questions with expected results; measure execution accuracy",
        "Log tokens, latency and cost per request (as GetLlmData did)"
      ]
    },
    {
      "slug": "proj-ingestion-api",
      "title": "Ingestion service in FastAPI + SQLAlchemy + pytest",
      "track": "backend",
      "level": "intermediate",
      "why_md": "Re-creates the patterns of ECSMarketplaceDataUpload in a public, tested codebase using the frameworks you haven't used yet.",
      "steps": [
        "FastAPI upload endpoint with Pydantic validation",
        "Registry/dispatcher of report processors with lazy imports",
        "SQLAlchemy 2.0 models + Alembic migrations",
        "Upserts with ON CONFLICT via SQLAlchemy insert().on_conflict_do_update",
        "Upload status tracking + background processing",
        "pytest suite with fixtures and a test database; GitHub Actions CI",
        "Structured logging and specific exception handling throughout"
      ]
    },
    {
      "slug": "proj-local-rag",
      "title": "Private RAG over this platform's knowledge base",
      "track": "ai",
      "level": "advanced",
      "why_md": "Learn embeddings, chunking, pgvector, hybrid search and RAG evaluation on content you care about, fully offline.",
      "steps": [
        "Chunk topic markdown with overlap",
        "Local embedding model (sentence-transformers)",
        "Store vectors in PostgreSQL + pgvector",
        "Hybrid search: BM25/full-text + vector, reciprocal rank fusion",
        "Answer with a local LLM, citing sources",
        "Evaluate retrieval (recall@k) and answer faithfulness on 20 questions"
      ]
    },
    {
      "slug": "proj-job-queue",
      "title": "Postgres-backed job queue with retries",
      "track": "backend",
      "level": "advanced",
      "why_md": "Formalises what you built in ForcesightJobSchedulerAndRunner (FOR UPDATE SKIP LOCKED) and compares it with Redis/Celery.",
      "steps": [
        "jobs table with status, attempts, run_at",
        "Workers claiming jobs with SKIP LOCKED",
        "Exponential backoff + dead-letter status",
        "Idempotent handlers",
        "Concurrency tests with multiple workers",
        "Write-up: Postgres queue vs Redis/Celery vs SQS"
      ]
    }
  ]
